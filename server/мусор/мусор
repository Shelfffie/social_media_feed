const findByIdMidl = async (req, res, next) => {
  try {
    const { id } = req.params;
    const check = await Student.findById(id);
    if (!check) {
      return res
        .status(404)
        .json({ message: "В списку немає такого студента." });
    }
    next();
  } catch (error) {
    res.status(500).json({ message: "Server error", error: error.message });
  }
};

app.post("/students", async (req, res) => {
  try {
    const body = req.body;
    if (!body.name || !body.age || !body.group) {
      return res
        .status(400)
        .json({ message: "Всі поля повинні бути заповнені!" });
    }
    const student = new Student(body);
    await student.save();
    res.status(201).json({ message: "Успішно додано!", student });
  } catch (error) {
    res.status(500).json({ message: "Server error", error: error.message });
  }
});

app.get("/students", async (req, res) => {
  try {
    const { group } = req.query;
    let students;
    if (group) {
      students = await Student.find({ group });
    } else {
      students = await Student.find();
    }

    if (students.length === 0) {
      return res.status(404).json({ message: "Список пустий" });
    }

    res.json(students);
  } catch (error) {
    res.status(500).json({ message: "Server error", error: error.message });
  }
});

app.put("/student/:id", findByIdMidl, async (req, res) => {
  try {
    const { id } = req.params;
    const { age } = req.body;
    if (!age) {
      return res.status(400).json({ message: "Вік не введено!" });
    }
    if (age < 16) {
      return res
        .status(400)
        .json({ message: "Корситувачу не може бути менше 16!" });
    }
    const updated = await Student.findByIdAndUpdate(
      id,
      { age: age },
      { new: true }
    );
    res.json(updated);
  } catch (error) {
    res.status(500).json({ message: "Server error", error: error.message });
  }
});

app.delete("/student/:id", findByIdMidl, async (req, res) => {
  try {
    const { id } = req.params;
    await Student.findByIdAndDelete(id);
    res.json({ message: "Успішно видалено!" });
  } catch (error) {
    res.status(500).json({ message: "Server error", error: error.message });
  }
});